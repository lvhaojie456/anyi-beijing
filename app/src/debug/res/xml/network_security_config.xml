<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override. Release keeps src/main's config (cleartext forbidden everywhere).
  Plain HTTP is allowed only to the emulator's host alias and loopback so a debug build
  can talk to the isolated local API from `backend/scripts/start-live2d-local.mjs`.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
