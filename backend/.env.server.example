PORT=8787
HOST=127.0.0.1
NODE_ENV=production
DB_DRIVER=sqlite

# SQLite defaults. Keep these for rollback even after switching DB_DRIVER=mysql.
# ANYI_DB_PATH=/var/lib/anyi-memorial-api/anyi.sqlite

# MySQL settings used only when DB_DRIVER=mysql.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=anyi_api
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_DATABASE=anyi_memorial
MYSQL_CONNECTION_LIMIT=10
# ANYI_MYSQL_MIGRATIONS_DIR=/opt/anyiapp2/backend/migrations-mysql

# Keep this value stable. Changing it will invalidate existing login tokens.
AUTH_SECRET=replace-with-a-long-random-secret

# Tencent Cloud deployment defaults.
ANYI_DATA_DIR=/var/lib/anyi-memorial-api
PUBLIC_ASSET_BASE_URL=https://api.anyibj.cn
ALLOWED_ORIGINS=https://api.anyibj.cn
RATE_LIMIT_ENABLED=true

# Payment is disabled until a real provider and signed webhook are deployed.
PAYMENT_ENABLED=false
PAYMENT_WEBHOOK_SECRET=replace-with-payment-webhook-secret

# Apexin is the single server-side provider for chat and image generation.
# Never ship APEXIN_API_KEY in Android, source control, logs, or API responses.
APEXIN_BASE_URL=https://api.apexin.ai/v1
APEXIN_API_KEY=replace-with-apexin-api-key
AI_MODEL=gpt-5.6-luna
AI_MEMORY_MODEL=gpt-5.5
AI_TIMEOUT_MS=90000

# User voice messages. Tencent Cloud SentenceRecognition is the production provider.
AI_VOICE_ENABLED=false
AI_VOICE_RETAIN_AUDIO=true
ASR_PROVIDER=tencent
ASR_TIMEOUT_MS=60000
TENCENT_ASR_SECRET_ID=replace-with-tencent-asr-secret-id
TENCENT_ASR_SECRET_KEY=replace-with-tencent-asr-secret-key
TENCENT_ASR_REGION=ap-beijing
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh
TENCENT_ASR_ENDPOINT=https://asr.tencentcloudapi.com

# Optional fallback for a separately approved OpenAI-compatible ASR provider.
ASR_BASE_URL=
ASR_API_KEY=replace-with-asr-key
ASR_MODEL=whisper-1

# WeChat Open Platform mobile app login.
# Fill these after the Android app is approved in 微信开放平台.
WECHAT_APP_ID=wx_your_mobile_app_id
WECHAT_APP_SECRET=replace-with-wechat-app-secret

LEGAL_OPERATOR_NAME=安忆
LEGAL_CONTACT_EMAIL=544908186@qq.com
LEGAL_CONTACT_PHONE=+8619310425540
LEGAL_EFFECTIVE_DATE=2026-05-09
