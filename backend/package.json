{
  "name": "anyi-memorial-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.8.2"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "admin:promote": "node scripts/set-admin-role.mjs",
    "check": "tsc --noEmit",
    "db:migrate:mysql": "node scripts/migrate-sqlite-to-mysql.mjs",
    "db:migrate:mysql:dry-run": "node scripts/migrate-sqlite-to-mysql.mjs --dry-run",
    "server:build": "tsc -p tsconfig.node.json",
    "server:restart": "npm run server:build && npm run server:start",
    "server:start": "node dist-node/server/server.js",
    "test:migrations": "npm run server:build && node --test tests/migrations.test.mjs",
    "test:security": "npm run server:build && node --test tests/security.test.mjs",
    "test": "npm run check && npm run server:build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "hono": "4.13.5",
    "mysql2": "^3.22.5",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.8.0",
    "typescript": "^5.8.3"
  }
}
